{
  "name": "fileweaver",
  "version-string": "0.1.0",
  "builtin-baseline": "ec48c11eae9448c8c6e7739d93e06fa2433aa95f",
  "dependencies": [
    "cli11",
    "sqlite3",
    "catch2"
  ],
  "features": {
    "desktop": {
      "description": "Opt-in Windows Qt Widgets search application and interaction tests",
      "dependencies": [
        {
          "name": "qtbase",
          "platform": "windows",
          "default-features": false,
          "features": [
            "widgets",
            "testlib",
            "jpeg",
            "png"
          ]
        },
        {
          "name": "poppler",
          "platform": "windows",
          "default-features": false,
          "features": [
            "zlib"
          ]
        }
      ]
    }
  }
}
