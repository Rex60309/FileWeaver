if(NOT EXISTS "${TEST_EXECUTABLE}" OR NOT IS_DIRECTORY "${RESULT_DIRECTORY}")
  message(FATAL_ERROR "Desktop test executable/result directory missing")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef observation)
set(report "${RESULT_DIRECTORY}/desktop-${observation}.txt")
if(EXISTS "${report}")
  message(FATAL_ERROR "Desktop test report collision")
endif()
execute_process(COMMAND "${TEST_EXECUTABLE}" -o "${report},txt"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 55)
if(NOT EXISTS "${report}")
  message(FATAL_ERROR "Qt Test did not produce a report: ${result}: ${output}: ${error}")
endif()
file(READ "${report}" details)
message("${details}")
if(NOT result STREQUAL "0" OR NOT details MATCHES "Totals:.*0 failed, 0 skipped, 0 blacklisted")
  message(FATAL_ERROR "Desktop interaction tests failed: ${result}: ${output}: ${error}")
endif()
